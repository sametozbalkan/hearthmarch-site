---
/**
 * One station of the tale: a work hung like a museum piece, its label, and the chapter
 * beside it. The kilim (shape "runner") hangs full width below its chapter and travels
 * sideways with the scroll.
 */
import { Picture } from 'astro:assets';
import { type Band, PICTURE_FORMATS, type Station } from '../art.ts';
import type { StationCopy } from '../copy/types.ts';

interface Props {
  station: Station;
  copy: StationCopy;
  /** Hang the work on the right and the chapter on the left. */
  flip?: boolean;
  /** A line before the chapter, centred above the station. */
  prologue?: string;
}

const { station, copy, flip = false, prologue } = Astro.props;
const LIGHT_BANDS: readonly Band[] = ['dawn', 'day', 'dusk'];
const tone = LIGHT_BANDS.includes(station.band) ? 'tone-light' : 'tone-dark';
const headingId = `chapter-${station.id}`;
const classes = ['station', `band-${station.band}`, tone, `shape-${station.shape}`, flip ? 'flip' : ''];

const WORK_SIZES: Record<Station['shape'], { widths: number[]; sizes: string }> = {
  wide: { widths: [480, 800, 1200, 1672], sizes: '(min-width: 1300px) 700px, (min-width: 900px) 56vw, 92vw' },
  square: { widths: [480, 800, 1254], sizes: '(min-width: 900px) 520px, 92vw' },
  runner: { widths: [960, 1440, 1800, 2172], sizes: '(max-width: 640px) 960px, 1800px' },
};
const { widths, sizes } = WORK_SIZES[station.shape];
---

<section class:list={classes} id={station.id} aria-labelledby={headingId}>
  {prologue && <p class="prologue">{prologue}</p>}
  {
    station.shape === 'runner' ? (
      <>
        <div class="runner-tale">
          <div class="tale">
            <p class="numeral" aria-hidden="true">{copy.numeral}</p>
            <h2 id={headingId}>{copy.heading}</h2>
            {copy.paragraphs.map((p) => <p>{p}</p>)}
          </div>
        </div>
        <figure class="work runner">
          <div class="kilim-band" data-scroll-range="contain">
            <div class="kilim-track">
              <Picture src={station.image} alt={copy.alt} {...PICTURE_FORMATS} widths={widths} sizes={sizes} />
            </div>
          </div>
          <figcaption>
            <span class="work-subject">{copy.subject}</span>
            <span class="work-label">{copy.inspiredBy}</span>
          </figcaption>
        </figure>
      </>
    ) : (
      <div class="station-inner">
        <figure class="work">
          <div class="frame">
            <Picture src={station.image} alt={copy.alt} {...PICTURE_FORMATS} widths={widths} sizes={sizes} />
          </div>
          <figcaption>
            <span class="work-subject">{copy.subject}</span>
            <span class="work-label">{copy.inspiredBy}</span>
          </figcaption>
        </figure>
        <div class="tale">
          <p class="numeral" aria-hidden="true">{copy.numeral}</p>
          <h2 id={headingId}>{copy.heading}</h2>
          {copy.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    )
  }
</section>
