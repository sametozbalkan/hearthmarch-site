---
/** The press kit: the fact sheet, the game in short, its key features and the art at full size. */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { PICTURE_FORMATS, PRESS_FILES, STATIONS, icon, keyArt, logo, pressFilePath, vista } from '../art.ts';
import PageHead from '../components/PageHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CONTACT_EMAIL, PRESS_EMAIL } from '../config.ts';
import { copyFor } from '../copy/index.ts';
import type { Lang } from '../i18n.ts';
import Base from '../layouts/Base.astro';
import { artSizeLabel } from '../lib/files.ts';
import { splitAround } from '../lib/text.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { press, home } = copyFor(lang);

interface Item {
  image: ImageMetadata;
  fileName: string;
  name: string;
  note: string;
  alt: string;
  /** Show the picture on a checkerboard, for a transparent file. */
  checker?: boolean;
}

const items: Item[] = [
  { image: logo, fileName: 'hearthmarch-logo.png', ...press.files.logo, checker: true },
  { image: icon, fileName: 'hearthmarch-icon.png', ...press.files.icon },
  { image: keyArt, fileName: 'hearthmarch-key-art.jpg', ...press.files.keyArt },
  { image: vista, fileName: 'hearthmarch-ridge.jpg', ...press.files.vista },
  ...STATIONS.map((s) => {
    const c = home.stations[s.id];
    return { image: s.image, fileName: s.fileName, name: c.subject, note: c.inspiredBy, alt: c.alt };
  }),
];

const meta = (item: Item): string => {
  const source = PRESS_FILES[item.fileName];
  if (!source) throw new Error(`No source for ${item.fileName}`);
  const format = item.fileName.endsWith('.png') ? 'PNG' : 'JPEG';
  return `${format}, ${item.image.width} × ${item.image.height}, ${artSizeLabel(source)}`;
};

const ADDRESSES = { press: PRESS_EMAIL, contact: CONTACT_EMAIL } as const;
const [leadBefore, leadAfter] = splitAround(press.lead, '{email}');
---

<Base lang={lang} meta={press.meta} path="/press/">
  <div class="page tone-dark">
    <PageHead lang={lang} />
    <main class="page-main">
      <h1>{press.heading}</h1>
      <p class="lead">{leadBefore}<a href={`mailto:${PRESS_EMAIL}`}>{PRESS_EMAIL}</a>{leadAfter}</p>

      <h2>{press.factsHeading}</h2>
      <dl class="facts">
        {
          press.facts.map((fact) => (
            <>
              <dt>{fact.term}</dt>
              <dd>
                {'email' in fact ? (
                  <a href={`mailto:${ADDRESSES[fact.email]}`}>{ADDRESSES[fact.email]}</a>
                ) : (
                  fact.value
                )}
              </dd>
            </>
          ))
        }
      </dl>

      <h2>{press.aboutHeading}</h2>
      {press.about.map((p) => <p>{p}</p>)}

      <h2>{press.featuresHeading}</h2>
      <ul class="features">
        {press.features.map((f) => <li>{f}</li>)}
      </ul>

      <h2>{press.artHeading}</h2>
      <p>{press.artNote}</p>
      <ul class="downloads">
        {
          items.map((item) => (
            <li>
              <div class:list={['thumb', { checker: item.checker }]}>
                <Picture src={item.image} alt={item.alt} {...PICTURE_FORMATS} widths={[320, 640]} sizes="(max-width: 560px) 88vw, 260px" />
              </div>
              <span class="name">{item.name}</span>
              <span>{item.note}</span>
              <span class="meta">{meta(item)}</span>
              <a href={pressFilePath(item.fileName)} download={item.fileName}>
                {press.download}
                <span class="visually-hidden">: {item.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </div>
  <SiteFooter lang={lang} />
</Base>
