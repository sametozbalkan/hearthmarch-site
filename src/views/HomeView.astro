---
/**
 * The home page: the hero, then the tale on one stage. While the page scrolls the stage
 * stays put and the scroll moves the tale from scene to scene: the prologue, the seven
 * chapters (each with its work), and the finale, as the day turns into the night of the
 * eclipse and back towards dawn. The four cut-outs cross the stage between scenes.
 *
 * The page's first script (in the head) turns the stage on; without JavaScript the same
 * markup reads as a stacked page, one station after another.
 */
import { Picture } from 'astro:assets';
import { PICTURE_FORMATS, STATIONS, c1Dragon, c2FeltClouds, c3Standard, c4Huma, logo, vista } from '../art.ts';
import ChapterRail from '../components/ChapterRail.astro';
import Finale from '../components/Finale.astro';
import Scene from '../components/Scene.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SoundDock from '../components/SoundDock.astro';
import WishlistButton from '../components/WishlistButton.astro';
import { copyFor } from '../copy/index.ts';
import type { StationId } from '../copy/types.ts';
import type { Lang } from '../i18n.ts';
import Base from '../layouts/Base.astro';
import '../styles/tale.css';
import { TOTAL, taleCss } from '../tale.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { site, home } = copyFor(lang);

const station = (id: StationId) => {
  const s = STATIONS.find((st) => st.id === id);
  if (!s) throw new Error(`No station ${id}`);
  return s;
};
const chapters = STATIONS.map((s) => ({ id: s.id, copy: home.stations[s.id] }));
const LOGO_WIDTHS = [480, 800, 1200, 1600];
const css = taleCss();
---

<Base lang={lang} meta={home.meta} path="/">
  <Fragment slot="head">
    <script is:inline>
      // The stage needs JavaScript; scroll-driven animations drive it where the browser has
      // them, and the page's script plays the same keyframes elsewhere.
      (function () {
        var root = document.documentElement;
        var sda =
          typeof CSS !== 'undefined' &&
          CSS.supports('animation-timeline: view()') &&
          CSS.supports('animation-range: entry 0% contain 100%');
        root.classList.add('js', 'stage', sda ? 'sda' : 'motion-js');
      })();
    </script>
    <style is:inline set:html={css} />
  </Fragment>

  <SoundDock music={home.music} volume={home.volume} listen={home.listen} />

  <main>
    <section class="hero">
      <div class="hero-stage">
        <div class="hero-copy">
          <h1 class="hero-title" id="title">
            <Picture
              src={logo}
              alt={site.name}
              {...PICTURE_FORMATS}
              widths={LOGO_WIDTHS}
              sizes="(max-aspect-ratio: 6/5) 88vw, 34vw"
              loading="eager"
            />
          </h1>
          <p class="tagline">{home.tagline}</p>
          <WishlistButton label={site.wishlist} />
          <p class="coming">{site.comingTo}</p>
        </div>
        <div class="hero-art">
          <Picture
            src={vista}
            alt={home.heroAlt}
            {...PICTURE_FORMATS}
            widths={[640, 960, 1280, 1672]}
            sizes="(max-aspect-ratio: 6/5) 120vh, (max-aspect-ratio: 3/2) 133vw, 100vw"
            priority
          />
        </div>
      </div>
    </section>

    <div class="tale" style={`--tale-total: ${TOTAL}`}>
      <div class="stage" data-stage>
        <ChapterRail label={home.chapters} chapters={chapters} />

        <div class="interlude has-deco to-dawn is-near" data-cut="c2">
          <Picture
            src={c2FeltClouds}
            alt=""
            class="deco deco-clouds"
            {...PICTURE_FORMATS}
            widths={[400, 700, 1000, 1606]}
            sizes="(max-width: 464px) 300px, (min-width: 1536px) 900px, 60vw"
          />
        </div>

        <div class="scene scene-prologue band-dawn tone-light is-near" data-scene="prologue">
          <div class="wall"></div>
          <div class="scene-body">
            <p class="prologue-line">{home.prologue}</p>
          </div>
        </div>

        <Scene station={station('hearth')} copy={home.stations.hearth} replayLabel={home.replay} />

        <div class="interlude dawn-to-day"></div>

        <Scene station={station('day')} copy={home.stations.day} replayLabel={home.replay} flip />

        <div class="interlude has-deco day-to-dusk" data-cut="c3">
          <Picture
            src={c3Standard}
            alt=""
            class="deco deco-standard"
            {...PICTURE_FORMATS}
            widths={[180, 360, 528]}
            sizes="(min-aspect-ratio: 23/20) 26vh, 150px"
          />
        </div>

        <Scene station={station('steppe')} copy={home.stations.steppe} replayLabel={home.replay} />

        <div class="interlude dusk-to-night"></div>

        <Scene station={station('night')} copy={home.stations.night} replayLabel={home.replay} flip />

        <div class="interlude has-deco night-to-eclipse" data-cut="c1">
          <Picture
            src={c1Dragon}
            alt=""
            class="deco deco-dragon"
            {...PICTURE_FORMATS}
            widths={[640, 1000, 1500, 2141]}
            sizes="(min-aspect-ratio: 23/20) 112vw, 175vw"
          />
        </div>

        <Scene station={station('eclipse')} copy={home.stations.eclipse} replayLabel={home.replay} />

        <div class="interlude eclipse-to-ember"></div>

        <Scene station={station('goc')} copy={home.stations.goc} replayLabel={home.replay} />

        <div class="interlude has-deco ember-to-deep" data-cut="c4">
          <Picture
            src={c4Huma}
            alt=""
            class="deco deco-huma"
            {...PICTURE_FORMATS}
            widths={[300, 600, 900, 1200]}
            sizes="(max-width: 625px) 240px, (min-width: 1500px) 520px, 36vw"
          />
        </div>

        <Scene station={station('together')} copy={home.stations.together} replayLabel={home.replay} flip />

        <div class="interlude deep-to-close"></div>

        <Finale outro={home.outro} wishlist={site.wishlist} comingTo={site.comingTo} />
      </div>
    </div>
  </main>
  <SiteFooter lang={lang} />

  <script>
    import { startStage } from '../scripts/stage.ts';
    import { startSound } from '../scripts/sound.ts';

    const stage = startStage();
    startSound(stage);
  </script>
</Base>
